import type jsPDF from "jspdf";
import {
  BAND_PALETTES,
  CLINICAL,
  DISCLAIMER,
  FRAMEWORK_LINE,
  FRAME,
  HEADER_BG,
  type HazardLogReport,
  NAVY,
  NAVY_BG,
  NAVY_LIGHT,
  NAVY_MID,
  NAVY_SOFT,
  type RGB,
  TEXT_BODY,
  WHITE,
} from "./types";

export class PdfBuilder {
  doc: jsPDF;
  report: HazardLogReport;
  logoDataUrl: string | null;
  logoAspect: number;

  pageWidth: number;
  pageHeight: number;
  MARGIN = 48;
  HEADER_H = 64;
  FOOTER_H = 60;
  FRAME_INSET = 22;
  CONTENT_TOP: number;
  CONTENT_BOTTOM: number;
  CONTENT_W: number;
  y: number;
  isFirstPage = true;

  constructor(
    doc: jsPDF,
    report: HazardLogReport,
    logoDataUrl: string | null = null,
    logoAspect = 3.77,
  ) {
    this.doc = doc;
    this.report = report;
    this.logoDataUrl = logoDataUrl;
    this.logoAspect = logoAspect;
    this.pageWidth = doc.internal.pageSize.getWidth();
    this.pageHeight = doc.internal.pageSize.getHeight();
    this.CONTENT_TOP = this.HEADER_H + 30;
    this.CONTENT_BOTTOM = this.pageHeight - this.FOOTER_H - 16;
    this.CONTENT_W = this.pageWidth - this.MARGIN * 2;
    this.y = this.CONTENT_TOP;
  }

  fill = (c: RGB) => this.doc.setFillColor(c[0], c[1], c[2]);
  stroke = (c: RGB) => this.doc.setDrawColor(c[0], c[1], c[2]);
  ink = (c: RGB) => this.doc.setTextColor(c[0], c[1], c[2]);

  drawHeaderBar() {
    const { doc, pageWidth, MARGIN, HEADER_H, report } = this;
    this.fill(HEADER_BG);
    doc.rect(0, 0, pageWidth, HEADER_H, "F");

    if (this.logoDataUrl) {
      const targetH = 28;
      const targetW = targetH * this.logoAspect;
      try {
        doc.addImage(this.logoDataUrl, "PNG", MARGIN, (HEADER_H - targetH) / 2, targetW, targetH);
      } catch {
        this.drawHeaderWordmark();
      }
    } else {
      this.drawHeaderWordmark();
    }

    this.ink(NAVY);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(8);
    const eyebrow = "CLINICAL SAFETY HAZARD LOG REPORT";
    doc.text(eyebrow, pageWidth - MARGIN - doc.getTextWidth(eyebrow), 28, { charSpace: 1.4 });

    this.ink(NAVY_MID);
    doc.setFont("helvetica", "normal");
    doc.setFontSize(8.5);
    const hid = report.hazardId + ", v" + report.version;
    doc.text(hid, pageWidth - MARGIN - doc.getTextWidth(hid), 44);

    this.fill(CLINICAL);
    doc.rect(0, HEADER_H, pageWidth, 1.5, "F");
  }

  private drawHeaderWordmark() {
    const { doc, MARGIN } = this;
    this.ink(NAVY);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(13);
    doc.text("Clinical AI Safety", MARGIN, 30);
    this.ink(NAVY_MID);
    doc.setFont("helvetica", "normal");
    doc.setFontSize(8.5);
    doc.text("clinicalaisafety.co.uk", MARGIN, 46);
  }

  drawFrame() {
    const { doc, pageWidth, pageHeight, FRAME_INSET } = this;
    this.stroke(FRAME);
    doc.setLineWidth(0.5);
    doc.rect(FRAME_INSET, FRAME_INSET, pageWidth - FRAME_INSET * 2, pageHeight - FRAME_INSET * 2, "S");
  }

  drawFooterBar() {
    const { doc, pageWidth, pageHeight, MARGIN, FOOTER_H, CONTENT_W } = this;
    const fy = pageHeight - FOOTER_H;
    this.stroke(NAVY_LIGHT);
    doc.setLineWidth(0.5);
    doc.line(MARGIN, fy, pageWidth - MARGIN, fy);

    doc.setFont("helvetica", "italic");
    doc.setFontSize(7.5);
    this.ink(NAVY_MID);
    doc.text(doc.splitTextToSize(DISCLAIMER, CONTENT_W * 0.6), MARGIN, fy + 14);

    doc.setFont("helvetica", "normal");
    this.ink(NAVY_MID);
    doc.text(FRAMEWORK_LINE, pageWidth - MARGIN - doc.getTextWidth(FRAMEWORK_LINE), fy + 14);
  }

  startPage() {
    if (!this.isFirstPage) this.doc.addPage();
    this.isFirstPage = false;
    this.drawHeaderBar();
    this.drawFrame();
    this.drawFooterBar();
    this.y = this.CONTENT_TOP;
  }

  ensureRoom(needed: number) {
    if (this.y + needed > this.CONTENT_BOTTOM) this.startPage();
  }

  sectionLabel(label: string, gap = 14) {
    this.ensureRoom(28);
    this.doc.setFont("helvetica", "bold");
    this.doc.setFontSize(8.5);
    this.ink(CLINICAL);
    this.doc.text(label.toUpperCase(), this.MARGIN, this.y, { charSpace: 1.4 });
    this.y += gap;
  }

  hrule() {
    this.ensureRoom(12);
    this.stroke(NAVY_LIGHT);
    this.doc.setLineWidth(0.5);
    this.doc.line(this.MARGIN, this.y, this.pageWidth - this.MARGIN, this.y);
    this.y += 16;
  }

  body(text: string) {
    if (!text || !text.trim()) {
      this.muted("(not provided)");
      return;
    }
    this.doc.setFont("helvetica", "normal");
    this.doc.setFontSize(10.5);
    this.ink(TEXT_BODY);
    const lines = this.doc.splitTextToSize(text, this.CONTENT_W);
    this.ensureRoom(lines.length * 14 + 6);
    this.doc.text(lines, this.MARGIN, this.y);
    this.y += lines.length * 14 + 14;
  }

  muted(text: string) {
    this.doc.setFont("helvetica", "italic");
    this.doc.setFontSize(10);
    this.ink(NAVY_SOFT);
    this.ensureRoom(20);
    this.doc.text(text, this.MARGIN, this.y);
    this.y += 20;
  }

  bandChip(band: string, x: number, yPos: number, fs = 9, px = 8, py = 4) {
    const p = BAND_PALETTES[band] ?? { bg: NAVY_BG, fg: NAVY, border: NAVY_LIGHT };
    this.doc.setFont("helvetica", "bold");
    this.doc.setFontSize(fs);
    const tw = this.doc.getTextWidth(band.toUpperCase());
    const w = tw + px * 2;
    const h = fs + py * 2;
    this.fill(p.bg);
    this.stroke(p.border);
    this.doc.setLineWidth(0.5);
    this.doc.roundedRect(x, yPos - h + py, w, h, 3, 3, "FD");
    this.ink(p.fg);
    this.doc.text(band.toUpperCase(), x + px, yPos, { charSpace: 1 });
  }

  statusChip(text: string, palette: { bg: RGB; fg: RGB; border: RGB }, x: number, yPos: number, fs = 9, px = 8, py = 4) {
    this.doc.setFont("helvetica", "bold");
    this.doc.setFontSize(fs);
    const tw = this.doc.getTextWidth(text.toUpperCase());
    const w = tw + px * 2;
    const h = fs + py * 2;
    this.fill(palette.bg);
    this.stroke(palette.border);
    this.doc.setLineWidth(0.5);
    this.doc.roundedRect(x, yPos - h + py, w, h, 3, 3, "FD");
    this.ink(palette.fg);
    this.doc.text(text.toUpperCase(), x + px, yPos, { charSpace: 1.2 });
    return w;
  }

  tableHeader(headers: string[], widths: number[]) {
    const { doc, MARGIN, CONTENT_W } = this;
    this.ensureRoom(28);
    this.fill(NAVY);
    doc.rect(MARGIN, this.y, CONTENT_W, 22, "F");
    this.ink(WHITE);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(7.5);
    let x = MARGIN;
    for (let i = 0; i < headers.length; i++) {
      doc.text(headers[i].toUpperCase(), x + 8, this.y + 14, { charSpace: 1.2 });
      x += widths[i];
    }
    this.y += 22;
  }

  tableRow(cells: string[], widths: number[], index: number) {
    const { doc, MARGIN, CONTENT_W } = this;
    doc.setFont("helvetica", "normal");
    doc.setFontSize(9);
    const wrapped = cells.map((c, i) => doc.splitTextToSize(c || "(none)", widths[i] - 16));
    const rowH = Math.max(...wrapped.map((w) => w.length)) * 12 + 14;
    this.ensureRoom(rowH);
    if (index % 2 === 0) {
      this.fill(NAVY_BG);
      doc.rect(MARGIN, this.y, CONTENT_W, rowH, "F");
    }
    this.stroke(NAVY_LIGHT);
    doc.setLineWidth(0.4);
    doc.line(MARGIN, this.y + rowH, MARGIN + CONTENT_W, this.y + rowH);
    this.ink(TEXT_BODY);
    let x = MARGIN;
    for (let j = 0; j < wrapped.length; j++) {
      doc.text(wrapped[j], x + 8, this.y + 16);
      x += widths[j];
    }
    this.y += rowH;
  }

  stampPageNumbers() {
    const total = this.doc.getNumberOfPages();
    for (let p = 1; p <= total; p++) {
      this.doc.setPage(p);
      const fy = this.pageHeight - this.FOOTER_H;
      this.doc.setFont("helvetica", "bold");
      this.doc.setFontSize(7.5);
      this.ink(NAVY);
      const txt = "Page " + p + " of " + total;
      this.doc.text(txt, this.pageWidth - this.MARGIN - this.doc.getTextWidth(txt), fy + 28);
    }
  }

  labelValueRow(label: string, value: string, labelW: number, alt: boolean) {
    const { doc, MARGIN, CONTENT_W } = this;
    const valueW = CONTENT_W - labelW - 14;
    const safe = value && value.trim() ? value : "(not provided)";
    doc.setFont("helvetica", "normal");
    doc.setFontSize(10.5);
    const lines = doc.splitTextToSize(safe, valueW);
    const rowH = Math.max(36, lines.length * 13 + 16);
    this.ensureRoom(rowH + 4);
    if (alt) {
      this.fill(NAVY_BG);
      doc.rect(MARGIN, this.y - 2, CONTENT_W, rowH, "F");
    }
    this.fill(CLINICAL);
    doc.rect(MARGIN, this.y - 2, 2, rowH, "F");
    doc.setFont("helvetica", "bold");
    doc.setFontSize(8);
    this.ink(CLINICAL);
    doc.text(label.toUpperCase(), MARGIN + 12, this.y + 12, { charSpace: 1.2 });
    doc.setFont("helvetica", "normal");
    doc.setFontSize(10.5);
    this.ink(value && value.trim() ? TEXT_BODY : NAVY_SOFT);
    doc.text(lines, MARGIN + labelW + 14, this.y + 12);
    this.y += rowH;
  }
}
